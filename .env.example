# Copy this file to .env and fill in your Firebase web app config.
# Get these values from the Firebase console (Project settings > Your apps > Web app).
# NEVER commit a real .env — it is git-ignored.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Optional: reCAPTCHA v3 site key for Firebase App Check in production.
# Leave empty for local development — the app uses the App Check debug provider
# when VITE_APPCHECK_DEBUG=true (register the debug token in the Firebase console).
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG=true
